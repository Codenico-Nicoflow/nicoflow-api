{
  "info": {
    "name": "Nicoflow — Auth & Users",
    "_postman_id": "b6f0c4a2-1e3d-4f7a-9c21-9a0f2e7b1d01",
    "description": "Authentication & user-management endpoints for the Nicoflow API.\n\nUsage:\n1. Import this collection and the `Nicoflow-Local` environment.\n2. Run **Register**, then **Login** — Login's test script captures the access token into `{{authToken}}`, so the protected requests (Logout all / Users) authenticate automatically.\n3. Reset/verify tokens arrive by email; paste the raw token into `{{resetToken}}` / `{{verifyToken}}` before running those requests.\n\nRequest bodies match the backend DTOs in `internal/domain/auth/types.go` exactly (e.g. login uses `identifier`, reset uses `newPassword`/`confirmPassword`/`token`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "const body = pm.response.json();",
                  "pm.test('envelope has user, no token (no auto-login)', () => {",
                  "  pm.expect(body.error).to.be.null;",
                  "  pm.expect(body.data.user.email).to.be.a('string');",
                  "  pm.expect(body.data.token).to.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"platform\": \"web\"\n}"
            },
            "description": "Create an account. Sends a verification email; does not log in (no token, no cookie)."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "  pm.environment.set('authToken', body.data.token);",
                  "  pm.test('captured access token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"remember\": true,\n  \"platform\": \"web\"\n}"
            },
            "description": "Authenticate by email OR username (`identifier`). Returns a JWT + sets the HttpOnly refresh cookie. Captures the token into {{authToken}}."
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) { pm.environment.set('authToken', body.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Rotate the refresh token (read from the HttpOnly cookie set by Login) and mint a fresh access token. Replaying a consumed token triggers reuse detection (revokes all sessions)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "End the current session (revokes the refresh token from the cookie, clears it). Public — authenticates off the cookie, not the JWT. Idempotent → 204."
          }
        },
        {
          "name": "Logout all (protected)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout-all", "host": ["{{baseUrl}}"], "path": ["auth", "logout-all"] },
            "description": "Revoke every refresh token for the authenticated user. Requires a valid access token → 204."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "description": "Send a reset email. Always 200 (no user enumeration)."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
            },
            "description": "Set a new password with the single-use token from the email. Paste it into {{resetToken}} first. Revokes all sessions on success."
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verifyToken}}\"\n}" },
            "description": "Confirm the email with the single-use token from the verification email. Paste it into {{verifyToken}} first."
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/resend-verification", "host": ["{{baseUrl}}"], "path": ["auth", "resend-verification"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "description": "Re-send the verification link. Always 200 (no user enumeration)."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get profile (protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] },
            "description": "Return the authenticated user's profile."
          }
        },
        {
          "name": "Update me (protected)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nico\",\n  \"lastName\": \"Flow\",\n  \"timezone\": \"Europe/Berlin\",\n  \"theme\": \"dark\"\n}"
            },
            "description": "Update profile fields. All optional; omitted fields are unchanged."
          }
        },
        {
          "name": "Delete me (protected)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Soft-delete the account (sets deleted_at) and revoke all refresh tokens → 204."
          }
        }
      ]
    }
  ]
}
