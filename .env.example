# Required
DATABASE_URL=postgres://user:password@localhost:5432/nicoflow?sslmode=disable
TEST_DATABASE_URL=postgres://user:password@localhost:5432/nicoflow_test?sslmode=disable
JWT_SECRET=your-256-bit-secret

# Lemon Squeezy
LS_WEBHOOK_SECRET=your-ls-webhook-secret

# AWS / S3 (optional for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# CORS
CORS_ORIGINS=http://localhost:3000

# App
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Docker Compose Postgres (used by docker-compose.yml only)
POSTGRES_USER=nicoflow
POSTGRES_PASSWORD=nicoflow
POSTGRES_DB=nicoflow

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
