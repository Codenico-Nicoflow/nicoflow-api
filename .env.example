# Required
DB_URL=postgres://user:password@localhost:5432/nicoflow?sslmode=disable
JWT_SECRET=your-256-bit-secret

# Lemon Squeezy
LS_WEBHOOK_SECRET=your-ls-webhook-secret

# AWS / S3 (optional for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# CORS
CORS_ORIGINS=http://localhost:3000

# App
APP_ENV=development
PORT=8080

# Docker Compose Postgres (used by docker-compose.yml only)
POSTGRES_USER=nicoflow
POSTGRES_PASSWORD=nicoflow
POSTGRES_DB=nicoflow
