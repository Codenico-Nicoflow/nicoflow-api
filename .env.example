# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/nicoflow?sslmode=disable  # PostgreSQL connection string (pgx DSN format)
JWT_SECRET=your-256-bit-secret-here                                             # HS256 signing secret — minimum 32 bytes, cryptographically random
PORT=8080                                                                        # HTTP port the API listens on (Render sets this automatically in production)

# ── Database (test) ───────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgres://user:password@localhost:5432/nicoflow_test?sslmode=disable  # Separate DB for integration tests; tests are skipped if unset

# ── Billing — Lemon Squeezy ───────────────────────────────────────────────────
LS_WEBHOOK_SECRET=your-ls-webhook-secret  # HMAC-SHA256 secret for verifying Lemon Squeezy webhook payloads

# ── File Storage — AWS S3 (production; use MinIO locally instead) ─────────────
AWS_ACCESS_KEY_ID=         # IAM access key with S3 read/write permissions
AWS_SECRET_ACCESS_KEY=     # IAM secret key
S3_BUCKET_NAME=            # S3 bucket name (e.g. nicoflow-attachments)

# App
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000  # Comma-separated list of allowed origins

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development  # Runtime environment: development | staging | production

# ── Docker Compose only (not read by the API binary) ─────────────────────────
POSTGRES_USER=nicoflow      # Postgres superuser created by the postgres container
POSTGRES_PASSWORD=nicoflow  # Postgres superuser password
POSTGRES_DB=nicoflow        # Default database created on first boot
