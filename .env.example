# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/nicoflow?sslmode=disable
JWT_SECRET=your-256-bit-secret-here-minimum-32-bytes-cryptographically-random
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
PORT=8080

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_BASE_URL=http://localhost:5173
TRUSTED_PROXY=http://localhost:5173

# E2E rate-limit bypass: a request with header `X-E2E-Bypass: <this>` skips the
# IP/user rate limiters. Set ONLY on staging (for the live E2E suite). NEVER set
# in production. Unset ⇒ no bypass, limits always apply.
RATE_LIMIT_BYPASS_TOKEN=

# ── Email — Mailtrap SMTP (password reset) ───────────────────────────────────
# Format: smtp://user:pass@smtp.mailtrap.io:587
SMTP_DSN=smtp://your-mailtrap-user:your-mailtrap-pass@smtp.mailtrap.io:587

# Gate login on a verified email. Leave false in local dev (no SMTP). Recommended
# true on BOTH staging and prod so the reject path is exercised before production.
REQUIRE_EMAIL_VERIFICATION=false

# ── Database (test) ───────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgres://user:password@localhost:5432/nicoflow_test?sslmode=disable

# ── Billing — Lemon Squeezy ───────────────────────────────────────────────────
LS_WEBHOOK_SECRET=your-ls-webhook-secret

# ── Internal jobs (cron) ──────────────────────────────────────────────────────
# Shared secret for POST /internal/jobs/* (e.g. the due-date sweep). Sent by the
# Render Cron Job as the X-Internal-Token header. Unset ⇒ those endpoints 503.
CRON_SECRET=your-internal-cron-secret

# ── Web Push (VAPID) — Pro browser push (E-025) ───────────────────────────────
# Base64url-encoded VAPID keys (RFC 8292). Generate a P-256 keypair; the public
# key also goes to the frontend for PushManager.subscribe. All three unset ⇒ web
# push is a silent no-op (safe local/dev, mirrors SMTP_DSN).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nicoflow.app

# ── File Storage — AWS S3 (production; MinIO used locally via docker compose) ─
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nicoflow-attachments
# AWS_ENDPOINT=http://localhost:9000   # uncomment to point at local MinIO

# ── Docker Compose only (not read by the API binary) ─────────────────────────
POSTGRES_USER=nicoflow
POSTGRES_PASSWORD=nicoflow
POSTGRES_DB=nicoflow
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
